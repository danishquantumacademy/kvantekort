    "domains": {
      "1": {
        "name": "Concepts and foundations",
        "block": "QB",
        "subdomains": {
          "1.1": "Basic quantum concepts",
          "1.2": "Mathematical formalism and information theory"
        }
      },
      "2": {
        "name": "Physical foundations of quantum technologies",
        "block": "QB",
        "subdomains": {
          "2.1": "Atomic physics",
          "2.2": "Quantum optics and electrodynamics",
          "2.3": "Solid-state physics",
          "2.4": "Quantum many-body systems and open quantum systems"
        }
      },
      "3": {
        "name": "Enabling technologies and techniques",
        "block": "CDT",
        "subdomains": {
          "3.1": "Laboratory techniques, noise and shielding",
          "3.2": "Solid-state technologies, nanotechnologies",
          "3.3": "Optical technologies",
          "3.4": "Control technologies",
          "3.5": "Computers and software"
        }
      },
      "4": {
        "name": "Quantum hardware",
        "block": "CDT",
        "subdomains": {
          "4.1": "Superconducting electronic circuits",
          "4.2": "Spin-based systems",
          "4.3": "Neutral atoms and ions",
          "4.4": "Photonic systems",
          "4.5": "Emerging qubit concepts",
          "4.6": "Quantum state control",
          "4.7": "Hybrid quantum-classical systems",
          "4.8": "Technology realisation"
        }
      },
      "5": {
        "name": "Quantum computing and simulation",
        "block": "QSA",
        "subdomains": {
          "5.1": "Basics",
          "5.2": "Quantum simulators",
          "5.3": "Quantum programming tools and software stack, error correction",
          "5.4": "Quantum computing subroutines",
          "5.5": "Quantum algorithms",
          "5.6": "Applications of quantum computing and simulation"
        }
      },
      "6": {
        "name": "Quantum sensors and imaging systems",
        "block": "QSA",
        "subdomains": {
          "6.1": "Basics",
          "6.2": "Electromagnetic field sensors",
          "6.3": "Temperature, particle and pressure sensors",
          "6.4": "Inertial and gravity sensors",
          "6.5": "Quantum imaging",
          "6.6": "Atomic clocks",
          "6.7": "Applications of quantum sensors"
        }
      },
      "7": {
        "name": "Quantum communication and networks",
        "block": "QSA",
        "subdomains": {
          "7.1": "Basics",
          "7.2": "Quantum random number generators",
          "7.3": "Quantum key distribution",
          "7.4": "Applications of quantum cryptography",
          "7.5": "Infrastructure for quantum information networks (quantum internet)",
          "7.6": "Systems networks (composite systems), quantum internet applications"
        }
      },
      "8": {
        "name": "Valorisation",
        "block": "QSA",
        "subdomains": {
          "8.1": "Industry landscape and market analysis",
          "8.2": "Business strategy, entrepreneurship and management",
          "8.3": "Impact and responsibility",
          "8.4": "Education and communication"
        }
      }
    },
    "areas": {
      "I": "Quantum concepts",
      "II": "QT hardware & software engineering",
      "III": "QT applications & strategies"
    },
    "levels": {
      "A1": "Awareness",
      "A2": "Literacy",
      "B1": "Utilisation",
      "B2": "Investigation",
      "C1": "Specialisation",
      "C2": "Innovation"
    },
    "level_by_area": {
      "I": {
        "A1": "Reproduce basic quantum concepts & terminology",
        "A2": "Describe fundamental quantum concepts",
        "B1": "Apply quantum methods to problems",
        "B2": "Analyse problems with quantum",
        "C1": "Refine and extend quantum methods",
        "C2": "Develop innovative solutions"
      },
      "II": {
        "A1": "Reproduce basic functionalities of a QT facet",
        "A2": "Perform basic tasks on a QT facet",
        "B1": "Modify/apply a QT facet",
        "B2": "Analyse performance, improve QT",
        "C1": "Conceptualise integrated QT systems",
        "C2": "Develop new QT facet"
      },
      "III": {
        "A1": "Recognise potential of QT",
        "A2": "Identify value of QT",
        "B1": "Classify available QT applications/approaches",
        "B2": "Analyse QT market and opportunities",
        "C1": "Advise on QT application selection or strategies",
        "C2": "Develop and assess QT (product) strategies"
      }
    }
  },
